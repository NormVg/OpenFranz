# Ollama Cloud credentials for the eve agent.
# Copy this file to .env and fill in the key. .env is gitignored.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# PostgreSQL (Neon) connection string.
DATABASE_URL=

# Google OAuth client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth session signing and local callback URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000


SARVAM_API_KEY=
