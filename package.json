{
  "name": "OpenFranz",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "NODE_OPTIONS=--no-network-family-autoselection nuxt dev",
    "dev:eve": "eve dev",
    "generate": "nuxt generate",
    "preview": "NODE_OPTIONS=--no-network-family-autoselection nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--no-network-family-autoselection drizzle-kit migrate",
    "db:studio": "NODE_OPTIONS=--no-network-family-autoselection drizzle-kit studio",
    "db:check": "NODE_OPTIONS=--no-network-family-autoselection tsx --env-file=.env scripts/db-check.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@neondatabase/serverless": "^1.2.0",
    "@pinia/nuxt": "^1.0.3",
    "ai": "^7.0.162",
    "ai-sdk-ollama": "^4.6.2",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "eve": "1.0.0-rc.3",
    "lucide-vue-next": "^1.0.0",
    "markstream-vue": "^2.0.23",
    "nuxt": "^4.6.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "just-bash": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  }
